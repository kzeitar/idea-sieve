# ============================================================================
# IDEA SIEVE - ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env and fill in your actual values
#
# Quick Start:
# 1. Copy this file: cp .env.example .env
# 2. Add your OpenAI and Tavily API keys below
# 3. Run: docker-compose up
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# PostgreSQL connection string
# For Docker (default): Use the value below
# For local PostgreSQL: Change 'postgres' to 'localhost'
DATABASE_URL=postgresql://postgres:password@postgres:5432/idea-sieve

# ============================================================================
# AI API KEYS (REQUIRED)
# ============================================================================
# OpenAI API Key - Get yours at: https://platform.openai.com/api-keys
# Required for AI-powered idea validation
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Tavily API Key - Get yours at: https://tavily.com
# Required for web research and competitor analysis
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# ============================================================================
# CORS & SERVER CONFIGURATION
# ============================================================================
# Frontend URL for CORS (using port 3002 for development to avoid port conflicts)
CORS_ORIGIN=http://localhost:3002

# Backend API URL (for frontend to connect)
VITE_SERVER_URL=http://localhost:3000

# ============================================================================
# OPTIONAL CONFIGURATION
# ============================================================================
# Environment: development, production, or test
# NODE_ENV=development
