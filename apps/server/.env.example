# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# For Docker: postgresql://postgres:password@postgres:5432/idea-sieve
# For local PostgreSQL: postgresql://postgres:password@localhost:5432/idea-sieve
DATABASE_URL=postgresql://postgres:password@postgres:5432/idea-sieve

# ============================================================================
# AI API KEYS
# ============================================================================
# OpenAI API Key - Get yours at: https://platform.openai.com/api-keys
# Required for idea validation using GPT-4 or other OpenAI models
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Tavily API Key - Get yours at: https://tavily.com
# Required for web research and competitor analysis during validation
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# Frontend URL for CORS (where your web app is hosted)
# For Docker: http://localhost:3001
# For production: https://yourdomain.com
CORS_ORIGIN=http://localhost:3001

# ============================================================================
# ENVIRONMENT (Optional)
# ============================================================================
# Options: development, production, test
# Default: development
# NODE_ENV=development