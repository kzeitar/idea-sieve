{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc -b",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "bun run --hot src/index.ts",
		"start": "bun run dist/index.js"
	},
	"dependencies": {
		"@hono/zod-validator": "^0.7.6",
		"@idea-sieve/ai": "workspace:*",
		"@idea-sieve/db": "workspace:*",
		"@idea-sieve/env": "workspace:*",
		"dotenv": "catalog:",
		"hono": "^4.8.2",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@idea-sieve/config": "workspace:*",
		"@types/bun": "catalog:",
		"tsdown": "^0.16.5",
		"typescript": "catalog:"
	}
}
